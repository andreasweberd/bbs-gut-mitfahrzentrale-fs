# ============================================================
# BBS GuT Rideshare (Mitfahrzentrale) - Environment Variables
# ============================================================

# Server Port (Standard: 3000)
PORT=3000

# Administrator Master-Token
ADMIN_TOKEN=Wulli

# ------------------------------------------------------------
# MySQL Datenbank-Konfiguration
# ------------------------------------------------------------
# Wenn diese Werte gesetzt sind, verbindet sich der Server automatisch
# mit der MySQL-Datenbank und initialisiert die Tabellen 'schueler' und 'eintraege'.
# Falls nicht gesetzt, nutzt der Server einen In-Memory-Speicher.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bbs_user
MYSQL_PASSWORD=geheimes_passwort
MYSQL_DATABASE=bbs_mitfahrzentrale

# Alternativ als vollständige Connection-URI:
# DATABASE_URL=mysql://bbs_user:geheimes_passwort@localhost:3306/bbs_mitfahrzentrale

# ------------------------------------------------------------
# Optionale AI-Features (Gemini API)
# ------------------------------------------------------------
GEMINI_API_KEY=""

# Host-URL (bei Cloud Run / Reverse Proxy)
APP_URL=""
